# Configuration for running EhsimCAD v1 on a server of your own.
#
# Copy to `.env.deploy` and fill in. Keep the real file off the repository and
# readable only by the account that runs the services -- every secret the
# application has is in here.
#
# As shipped, this file matches the Postgres and the MinIO that `compose.yaml`
# starts alongside the application. Only one value has to be filled in before
# it will run: AUTH_SECRET. Everything else already agrees with the bundled
# services, and the section after it explains what to change when the database
# and the bucket are somebody else's.
#
# Check it before starting anything:
#   docker compose run --rm preflight
#   (or, without Docker:  cd web && node --env-file=../.env.deploy scripts/preflight.mjs)

# ------------------------------------------------------------ fill this in

# Signs session cookies. Generate one and keep it: changing it signs everyone
# out. At least 32 characters.
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------- required

# Postgres. `postgres` is the bundled one, reachable under that name on the
# Compose network. Any 14 or newer works; the application creates its own
# tables and needs a database and a user that owns it, nothing more.
#
# The password here and POSTGRES_PASSWORD in `compose.yaml` are the same
# password written twice. Change one and you must change the other.
DATABASE_URL=postgresql://ehsimcad:ehsimcad@postgres:5432/ehsimcad

# Object storage, spoken to over the S3 API. MinIO is bundled; Ceph, NetApp
# StorageGRID, AWS S3 and Supabase all answer the same protocol.
#
# Two addresses for one service, and the difference is the thing installs get
# wrong. Browsers upload and download directly, never through the application,
# so a presigned URL has to name an address the browser can open -- and the
# address a container uses to reach the same store is usually not it. The host
# is part of what gets signed, so this cannot be patched up afterwards.
#
#   STORAGE_ENDPOINT         what the server uses. Bundled: http://minio:9000
#   STORAGE_PUBLIC_ENDPOINT  what the browser uses. Leave unset when they are
#                            the same address, which is the ordinary case for a
#                            hosted bucket.
#
# `localhost:9000` below is right when you sit at the machine running Docker.
# For anyone else it has to be the server's own name or address -- otherwise
# every upload will fail on every desktop while passing every check here.
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# The bucket is addressed by path, not by subdomain, so an internal MinIO at
# https://storage.internal:9000 is given exactly that.
STORAGE_REGION=us-east-1
STORAGE_BUCKET=cad-models

# The bundled MinIO takes these as its root credentials, so the two sides agree
# by construction. Change them on a machine anyone else can reach.
STORAGE_ACCESS_KEY_ID=ehsimcad
STORAGE_SECRET_ACCESS_KEY=ehsimcad-storage

# The address people will type, and the one setting sign-in will not work
# without. The application is served from inside a container and cannot see
# what anybody typed -- every URL it builds for itself, including the one
# GitHub is sent back to, comes from here. Links in email too.
#
# Origin only: scheme, host, and a port if it is not the standard one. No path.
SITE_URL=http://localhost:3000

# ------------------------------------------- using your own database and bucket

# Nothing above is special to the bundled services except the names. Point
# these four at what you already run:
#
#   DATABASE_URL=postgresql://USER:PASSWORD@db.internal:5432/ehsimcad
#   STORAGE_ENDPOINT=https://storage.internal:9000
#   STORAGE_PUBLIC_ENDPOINT=          (empty, if that address works everywhere)
#   STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY from that store
#
# then add `--no-deps`, which is what leaves the bundled ones out. Naming the
# services alone is not enough -- Compose starts their dependencies too:
#
#   docker compose run --rm --no-deps preflight
#   docker compose run --rm --no-deps migrate
#   docker compose up -d --no-deps web worker
#
# Two things to check on a bucket that is not the bundled one: the key can
# write and delete as well as read, and the bucket allows cross-origin requests
# from SITE_URL -- methods GET, PUT and HEAD, and the `content-type` header.
# `preflight` tests the first. Only a browser tests the second.

# ---------------------------------------------------------------- optional

# Email. With no key the messages are written to the log instead of sent, which
# is a working configuration -- it only means a forgotten password cannot be
# recovered and an address cannot be confirmed. Sign-in itself is unaffected.
#
# The provider is reached over HTTPS, not SMTP. An internal relay is not
# supported yet; see INSTALL.md.
MAIL_API_KEY=
MAIL_FROM="EhsimCAD <noreply@example.com>"

# Sign in with GitHub, as well as with a password. Needs an OAuth application
# whose callback is SITE_URL + /api/auth/callback/github, and a server that can
# reach github.com. Leave empty for password-only.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Largest file accepted, and how long a presigned upload or download URL lives.
# Shown with their defaults.
# MAX_UPLOAD_MB=200
# STORAGE_URL_TTL_SECONDS=900

# A job still marked `processing` after this many seconds is treated as
# abandoned by a crashed worker and put back on the queue.
# STALE_JOB_SECONDS=1800

# ---------------------------------------------------------------- leave unset

# GITHUB_DISPATCH_TOKEN and GITHUB_REPOSITORY belong to the hosted deployment,
# where conversion runs as a GitHub Actions job because there is no server to
# run it on. Here there is one: the worker polls the queue continuously. Set
# these as well and every upload will also try to reach github.com, which on a
# closed network fails on every upload.
