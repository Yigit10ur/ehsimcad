# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment
.env
.env.*
# Templates carry no secrets and are what the setup instructions tell you to
# copy, so they belong in the repository.
!.env.example
!.env.fly.example
!.env.deploy.example

# Editors / OS
.DS_Store
*.swp

# Local tooling. The dev server configuration is per-machine: it names the
# command and port this checkout runs on, which is not something to impose on
# anyone else's clone.
.claude/

# Large CAD binaries are not committed (see CONTRIBUTING.md).
# Small, appropriately licensed test fixtures are the exception.
*.step
*.stp
*.iges
*.igs
*.glb
*.gltf
# DXF is text rather than binary, but a real drawing is just as large and just
# as much somebody's intellectual property.
*.dxf
*.dwg
*.stl
# Scratch output directories, wherever they appear.
converter/samples/
converter/out/

# Exceptions, listed last so they win: the generated STEP fixture and the
# viewer's development sample (8 KB), which lets the web app be worked on
# without a Python environment. Both are reproducible:
#   python scripts/make_fixture.py
#   python -m app.cli convert tests/fixtures/assembly.step \
#       ../web/public/samples/assembly.glb
!converter/tests/fixtures/**
!web/public/samples/**

# setuptools leaves a copy of the package here when the converter is installed
# from source (`pip install .`). It is a stale duplicate of `converter/app/`
# the moment anything changes, and reading it instead of the real thing is an
# easy hour to lose.
converter/build/

# The offline install archive: a gigabyte of built images, produced by
# `deploy/pack-images.sh` and carried to the server by hand.
ehsimcad-images-*.tar.gz
